# Puerto del servidor
PORT=3000

# Supabase (persistencia de facturas/usuarios + storage de PDFs)
# URL del proyecto: dashboard → Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Secret key (server-side, NUNCA la publishable/anon): dashboard → Project Settings → API
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Secreto para las sesiones (cámbialo por algo aleatorio)
SESSION_SECRET=cambia-esto-por-algo-seguro-2026

# Token compartido con n8n para el webhook (X-Portal-Token)
PORTAL_TOKEN=cambia-esto-tambien

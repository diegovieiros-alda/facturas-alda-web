# Puerto del servidor
PORT=3000

# PostgreSQL (facturas/usuarios/sesiones) — los PDFs se guardan en disco, en data/pdfs/
DATABASE_URL=postgres://usuario:password@localhost:5432/facturas_alda

# Secreto para las sesiones (cámbialo por algo aleatorio)
SESSION_SECRET=cambia-esto-por-algo-seguro-2026

# Token compartido con n8n para el webhook (X-Portal-Token)
PORTAL_TOKEN=cambia-esto-tambien

# Vacío en local/Vercel. En un despliegue bajo un subpath (ej. /facturas detrás de
# un proxy que recorta el prefijo) poner ese prefijo aquí, sin barra final.
BASE_PATH=
